# --- Application ---
APP_NAME="Compos Albion Online"

# Cle secrete utilisee pour signer les cookies de session.
# Generez-en une avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-moi-avec-une-cle-aleatoire

# Duree de validite d'une session, en secondes (defaut : 7 jours)
SESSION_MAX_AGE=604800

# Mettre a true uniquement derriere HTTPS (cookie Secure)
COOKIE_SECURE=false

# --- Base de donnees ---
DATABASE_URL=sqlite:///./database/compos.db

# --- Discord ---
# Webhook du salon ou les compos seront postees.
# Discord > Parametres du salon > Integrations > Webhooks > Nouveau webhook > Copier l'URL
# L'admin peut aussi la saisir depuis la page /admin (la valeur en base est prioritaire).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxxxxxx

# --- Compte administrateur cree au premier demarrage (si la base est vide) ---
ADMIN_PSEUDO=admin
ADMIN_PASSWORD=changez-ce-mot-de-passe
