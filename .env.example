# --- Application ---
APP_NAME="Compos Albion Online"
SECRET_KEY=changez-moi-avec-une-cle-aleatoire
SESSION_MAX_AGE=604800
COOKIE_SECURE=false

# --- Base de donnees ---
DATABASE_URL=sqlite:///./database/compos.db

# Adresse publique du site (sans slash final).
APP_BASE_URL=http://localhost:8000

# --- Discord ---
# Aucun webhook n'est stocke dans l'environnement ni en base.
# L'URL est demandee a l'utilisateur uniquement au moment de l'envoi.

# --- Compte administrateur cree au premier demarrage (si la base est vide) ---
ADMIN_PSEUDO=admin
ADMIN_PASSWORD=changez-ce-mot-de-passe
